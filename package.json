{
  "name": "repo-links-mod",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run lint:md && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "typecheck": "tsc --noEmit",
    "typecheck:mod": "bun scripts/claude-code-types.ts && tsc --noEmit -p tsconfig.mod.json",
    "lint:md": "markdownlint-cli2",
    "test": "bun test ./scripts",
    "knip": "knip",
    "build:markdown": "bun scripts/build-markdown.ts"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
